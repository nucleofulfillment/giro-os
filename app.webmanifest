{
  "id": "/app",
  "name": "LiveFood Entregador",
  "short_name": "Entregador",
  "description": "App do entregador LiveFood: rotas, entregas e caixa do dia.",
  "lang": "pt-BR",
  "start_url": "/app",
  "scope": "/app",
  "display": "standalone",
  "orientation": "portrait",
